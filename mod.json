{
    "geode": "5.7.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "maskagd.shader_visualizer",
    "name": "Trigger Visualizer",
    "version": "3.0.0-beta.5",
    "developer": "maskagd",
    "description": "Visually Enhances Triggers",
    "resources": {
        "sprites": [
            "resources/**/*.png",
            "resources/*.png"
        ]
    },
    "links": {
        "source": "https://github.com/maskagd/Trigger-Visualizer",
        "homepage": "https://www.youtube.com/@maskagd"
    },
    "tags": ["editor", "offline", "customization", "enhancement", "interface"],
    "settings": {
        "global-title": {
            "type": "title",
            "name": "global settings"
        },
        "theme-selector": {
            "type": "button",
            "name": "Texture theme",
            "buttons": {
                "open": "Select Theme"
            }
        },
        "new-triggers": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Enable mod",
            "description": "Toggle the mod on or off. Turning it off will revert to default textures and disable dynamic textures",
            "default": true,
            "spr1": "gl.textureDisable",
            "spr2": "gl.textureEnable"
        },
        "dyn-enable": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Enable dynamic textures",
            "description": "Toggle dynamic textures in the editor",
            "default": true,
            "spr1": "gl.dynamicDisable",
            "spr2": "gl.dynamicEnable"
        },
        "set-title": {
            "type": "title",
            "name": "texture settings"
        },
        "new-shake": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Shake texture",
            "description": "Choose shake texture",
            "default": false,
            "spr1": "shake",
            "spr2": "gl.shake"
        },
        "color-stop": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Area stop color texture",
            "description": "Choose area stop texture",
            "default": false,
            "spr1": "areaStop",
            "spr2": "color_areaStop"
        },
        "new-colis": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "collision block texture",
            "description": "Select texture style",
            "default": false,
            "spr1": "gl.collisionBlock",
            "spr2": "collisionBlock"
        },
        "dynamic-title": {
            "type": "title",
            "name": "dynamic texture settings"
        },
        "dyn-game": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Gameplay triggers dynamic texture",
            "description": "move, rotate, startpos, and gravity triggers",
            "default": true,
            "spr1": "move",
            "spr2": "move_direction"
        },
        "dyn-logic": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Logic triggers dynamic texture",
            "description": "item, event, collision, spawn and ui triggers",
            "default": true,
            "spr1": "event",
            "spr2": "event_land"
        },
        "dyn-cam": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Cameras dynamic texture",
            "description": "Cameras triggers",
            "default": true,
            "spr1": "offsetCam",
            "spr2": "OffsetCam_x"
        },
        "dyn-color": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Color dynamic texture",
            "description": "pulse and color triggers",
            "default": true,
            "spr1": "col",
            "spr2": "col_preset"
        },
        "dot-edit": {
            "type": "custom:maskagd.shader_visualizer/sprite-switch",
            "name": "Multiplication sign",
            "description": "Choose dot or star to represent multiplication in item edit",
            "default": true,
            "spr1": "edit_mul",
            "spr2": "edit_dot"
        },
        "off-ev": {
            "type": "float",
            "name": "Spacing between event textures",
            "description": "Spacing between textures in an event trigger when the event uses two different actions that do not share a common texture",
            "default": 7.5,
            "min": 0.0,
            "max": 15.0,
            "controls": {
                "arrows": true,
                "arrow-step": 2.0,
                "slider": true,
                "slider-step": 1.0,
                "input": true
            }
        },
        "sfx2": {
            "type": "float",
            "name": "SFX 1/4",
            "description": "Set the SFX volume so it shows one of the four levels",
            "default": 0.25,
            "min": 0.0,
            "max": 2.0,
            "controls": {
                "arrows": true,
                "arrow-step": 0.1,
                "slider": true,
                "slider-step": 0.1,
                "input": true
            }
        },
        "sfx3": {
            "type": "float",
            "name": "SFX 2/4",
            "description": "Set the SFX volume so it shows two of the four levels",
            "default": 0.50,
            "min": 0.0,
            "max": 2.0,
            "controls": {
                "arrows": true,
                "arrow-step": 0.1,
                "slider": true,
                "slider-step": 0.1,
                "input": true
            }
        },
        "sfx4": {
            "type": "float",
            "name": "SFX 3/4",
            "description": "Set the SFX volume so it shows three of the four levels",
            "default": 0.75,
            "min": 0.0,
            "max": 2.0,
            "controls": {
                "arrows": true,
                "arrow-step": 0.1,
                "slider": true,
                "slider-step": 0.1,
                "input": true
            }
        },
        "sfx5": {
            "type": "float",
            "name": "SFX 4/4",
            "description": "Set the SFX volume so it shows four of the four levels",
            "default": 1.25,
            "min": 0.0,
            "max": 2.0,
            "controls": {
                "arrows": true,
                "arrow-step": 0.1,
                "slider": true,
                "slider-step": 0.1,
                "input": true
            }
        }
    }
}
